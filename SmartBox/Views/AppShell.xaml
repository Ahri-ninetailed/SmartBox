<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:SmartBox.Views"
    xmlns:viewmodels="clr-namespace:SmartBox.ViewModels"
    
    x:Class="SmartBox.Views.AppShell"
    x:DataType="viewmodels:AppShellViewModel"
    FlyoutBehavior="Disabled"
    Shell.NavBarHasShadow="False">

    <Shell.TitleView>
        <Grid ColumnDefinitions="Auto,*,Auto" Padding="5,2,5,2" >

            <HorizontalStackLayout Grid.Column="0" Spacing="5">
                <Button Text="Dictionary" Command="{Binding GoToDictionaryCommand}" />
                <Button Text="Parser" Command="{Binding GoToParserCommand}" />
                <Button Text="Definitions" Command="{Binding GoToDefinitionsCommand}" />
            </HorizontalStackLayout>

            <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="6" Padding="15,0">
                <ActivityIndicator Grid.Column="0"
                                   IsRunning="{Binding DatabaseBackup.IsRunning}"
                                   IsVisible="{Binding DatabaseBackup.IsRunning}"
                                   WidthRequest="16"
                                   HeightRequest="16" />

                <Label Grid.Column="1"
                       Text="{Binding DatabaseBackup.Status}"
                       ToolTipProperties.Text="{Binding DatabaseBackup.Details}"
                       HorizontalOptions="Start"
                       VerticalOptions="Center"
                       MaxLines="1"
                       LineBreakMode="TailTruncation">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DatabaseBackup.ShowErrorCommand}" />
                    </Label.GestureRecognizers>
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding DatabaseBackup.IsFailed}" Value="True">
                            <Setter Property="TextColor" Value="{AppThemeBinding Light=#C42B1C, Dark=#FF99A4}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Grid>

            <HorizontalStackLayout Grid.Column="2" Spacing="5">
                <Button Text="🌞" Command="{Binding LightThemeClickedCommand}" />
                <Button Text="🌙" Command="{Binding DarkThemeClickedCommand}" />
            </HorizontalStackLayout>
        </Grid>
    </Shell.TitleView>

    <ShellContent ContentTemplate="{DataTemplate views:DictionaryPage}" Route="dictionary" />
    <ShellContent ContentTemplate="{DataTemplate views:ParserPage}" Route="parser" />
    <ShellContent ContentTemplate="{DataTemplate views:DefinitionsPage}" Route="definitions" />
</Shell>
