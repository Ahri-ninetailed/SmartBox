<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:SmartBox.ViewModels"
    xmlns:models="clr-namespace:SmartBox.Models.Parser"
    
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.TreeView;assembly=Syncfusion.Maui.TreeView"
    xmlns:inputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:behaviors="clr-namespace:SmartBox.Behaviors"
    x:DataType="viewmodels:ParserPageViewModel"
    x:Class="SmartBox.Views.ParserPage">

    <Grid RowDefinitions="Auto,*" Padding="20">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10">
            <Entry x:Name="WordEntry"
                   Grid.Column="0"
                   Placeholder="Enter word or ID"
                   Text="{Binding EntryText, Mode=TwoWay}">
                <Entry.Behaviors>
                    <toolkit:UserStoppedTypingBehavior StoppedTypingTimeThreshold="1000" />
                    <behaviors:SelectAllOnFocusBehavior />
                </Entry.Behaviors>
            </Entry>

            <inputs:SfComboBox Grid.Column="1"
                               MinimumWidthRequest="125"
                               x:Name="ExportComboBox"
                               ItemsSource="{Binding WordsForExport}"
                               SelectedItem="{Binding SelectedWordsForExport, Mode=TwoWay}"
                               DisplayMemberPath="Value"
                               Placeholder="{Binding ExportPlaceholder}"
                               WidthRequest="135"
                               VerticalOptions="Center"
                               IsEditable="False"
                               ShowBorder="True" />

            <Button Grid.Column="2"
                    Text="+"
                    Command="{Binding AddWordsForExportCommand}"
                    WidthRequest="40"
                    HeightRequest="40"
                    ToolTipProperties.Text="Add selected word pack to export list" />

            <Button Grid.Column="3"
                    Text="−"
                    Command="{Binding RemoveWordsForExportCommand}"
                    WidthRequest="40"
                    HeightRequest="40"
                    ToolTipProperties.Text="Remove selected word pack from export list" />

            <Button Grid.Column="4"
                    Text="🗑"
                    Command="{Binding ClearExportBufferCommand}"
                    WidthRequest="40"
                    HeightRequest="40"
                    ToolTipProperties.Text="Clear export buffer" />

            <Button Grid.Column="5"
                    Text="Lexilize"
                    Command="{Binding ExportLexilizeCommand}"
                    WidthRequest="80"
                    HeightRequest="40"
                    ToolTipProperties.Text="Export to Lexilize format" />

            <Button Grid.Column="6"
                    Text="Anki"
                    Command="{Binding ExportAnkiCommand}"
                    WidthRequest="60"
                    HeightRequest="40"
                    ToolTipProperties.Text="Export to Anki format" />

            <Button Grid.Column="7"
                    Text="Copy"
                    Command="{Binding CopyCommand}"
                    WidthRequest="60"
                    HeightRequest="40"
                    ToolTipProperties.Text="Copy to buffer" />

            <StackLayout Grid.Column="8"
                         Orientation="Horizontal"
                         Spacing="5"
                         VerticalOptions="Center">
                <Label Text="AI"
                       VerticalOptions="Center"
                       FontSize="14"/>
                <CheckBox IsChecked="{Binding IsAiEnabled, Mode=TwoWay}"
                          VerticalOptions="Center"/>
                <Label Text="Local only"
                       VerticalOptions="Center"
                       FontSize="14"/>
                <CheckBox IsChecked="{Binding IsAiLocalOnly, Mode=TwoWay}"
                          VerticalOptions="Center"/>
            </StackLayout>

            <Button Grid.Column="9"
                    Text="Enrich"
                    Command="{Binding EnrichCommand}"
                    WidthRequest="70"
                    HeightRequest="40"
                    ToolTipProperties.Text="Enrich word with another definitions and examples" />

            <Button Grid.Column="10"
                    Text="Unlock"
                    Command="{Binding UnlockCommand}"
                    WidthRequest="75"
                    HeightRequest="40"
                    ToolTipProperties.Text="Unlock word for sync" />

            <Button Grid.Column="11"
                    Text="Sync"
                    Command="{Binding SyncCommand}"
                    WidthRequest="60"
                    HeightRequest="40"
                    ToolTipProperties.Text="Sync word with db" />
        </Grid>

        <syncfusion:SfTreeView Grid.Row="1"
                           x:Name="TreeView"
                           ItemsSource="{Binding TreeViewNodes}"
                           ChildPropertyName="Children"
                           SelectionMode="None"
                           AutoExpandMode="AllNodesExpanded"
                           ItemTemplate="{StaticResource SelectableHierarchyNodeTemplate}" >
            <syncfusion:SfTreeView.Behaviors>
                <behaviors:EditNodeOnTapBehavior />
            </syncfusion:SfTreeView.Behaviors>
        </syncfusion:SfTreeView>
    </Grid>
</ContentPage>