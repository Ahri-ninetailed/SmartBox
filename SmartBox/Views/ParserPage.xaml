<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SmartBox.ViewModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.TreeView;assembly=Syncfusion.Maui.TreeView"
    xmlns:inputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    x:Class="SmartBox.Views.ParserPage">

    <Grid RowDefinitions="Auto,*" Padding="20">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10">
            <Entry Grid.Column="0" 
                   Placeholder="Entry" 
                   Text="{Binding EntryText, Mode=TwoWay}">
                <Entry.Behaviors>
                    <toolkit:UserStoppedTypingBehavior
                        Command="{Binding ParseCommand}"
                        StoppedTypingTimeThreshold="1000" />
                </Entry.Behaviors>
            </Entry>

            <inputs:SfComboBox Grid.Column="1"
                               MinimumWidthRequest="125"
                               x:Name="ExportComboBox"
                               ItemsSource="{Binding WordsForExport}"
                               SelectedItem="{Binding SelectedWordsForExport, Mode=TwoWay}"
                               DisplayMemberPath="Value"
                               Placeholder="{Binding ExportPlaceholder}"
                               WidthRequest="120"
                               VerticalOptions="Center"
                               IsEditable="False"
                               ShowBorder="True" />

            <Button Grid.Column="2"
                    Text="+"
                    Command="{Binding AddWordsForExportCommand}"
                    WidthRequest="40"
                    HeightRequest="40"
                    ToolTipProperties.Text="Add selected word pack to export list" />

            <Button Grid.Column="3"
                    Text="−"
                    Command="{Binding RemoveWordsForExportCommand}"
                    WidthRequest="40"
                    HeightRequest="40"
                    ToolTipProperties.Text="Remove selected word pack from export list" />

            <Button Grid.Column="4"
                    Text="Export"
                    Command="{Binding ExportCommand}"
                    WidthRequest="70"
                    HeightRequest="40"
                    ToolTipProperties.Text="Export selected word pack" />
            
            <Button Grid.Column="5"
                    Text="Enrich"
                    Command="{Binding EnrichCommand}"
                    WidthRequest="70"
                    HeightRequest="40"
                    ToolTipProperties.Text="Enrich word with another definitions and examples" />
        </Grid>

        <syncfusion:SfTreeView Grid.Row="1"
                               x:Name="TreeView"
                               ItemsSource="{Binding TreeViewNodes}"
                               ChildPropertyName="Children"
                               SelectionMode="None"
                               ItemTapped="OnItemTapped"
                               AutoExpandMode="AllNodesExpanded">

            <syncfusion:SfTreeView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  IsEnabled="{Binding IsEnabled}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  VerticalOptions="Center"/>

                        <Label Grid.Column="1"
                               Text="{Binding Title}"
                               VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding IsBold}"
                                             Value="True">
                                    <Setter Property="FontAttributes" Value="Bold"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>
                </DataTemplate>
            </syncfusion:SfTreeView.ItemTemplate>

        </syncfusion:SfTreeView>
    </Grid>
</ContentPage>