<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
    xmlns:inputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:SmartBox.ViewModels"
    xmlns:behaviors="clr-namespace:SmartBox.Behaviors"
    xmlns:models="clr-namespace:SmartBox.Models.Dictionary"
    
    x:DataType="viewmodels:DictionaryPageViewModel"
    x:Class="SmartBox.Views.DictionaryPage">

    <Grid Padding="30,0" RowDefinitions="Auto,*,Auto">

        <HorizontalStackLayout Grid.Row="0" Spacing="10">
            <Entry MinimumWidthRequest="100" x:Name="WordEntry" Placeholder="Word" Text="{Binding SearchText, Mode=TwoWay}">
                <Entry.Behaviors>
                    <toolkit:UserStoppedTypingBehavior StoppedTypingTimeThreshold="1000" />
                    <behaviors:SelectAllOnFocusBehavior />
                </Entry.Behaviors>
            </Entry>
            <Entry x:Name="CommentEntry" Placeholder="Comment" Text="{Binding CommentText, Mode=TwoWay}"/>
            <inputs:SfComboBox
                x:Name="PartOfSpeechComboBox"
                ItemsSource="{Binding PartOfSpeechOptions}"
                SelectedItem="{Binding SelectedPartOfSpeech, Mode=TwoWay}"
                MinimumWidthRequest="150"
                IsClearButtonVisible="False"
                IsEditable="False"/>
            <Entry MinimumWidthRequest="100" x:Name="MeaningEntry" Placeholder="Meaning" Text="{Binding MeaningSearchText, Mode=TwoWay}">
                <Entry.Behaviors>
                    <toolkit:UserStoppedTypingBehavior StoppedTypingTimeThreshold="1000" />
                    <behaviors:SelectAllOnFocusBehavior />
                </Entry.Behaviors>
            </Entry>
        </HorizontalStackLayout>

        <syncfusion:SfDataGrid
            x:Name="WordTable"
            Grid.Row="1"
            ItemsSource="{Binding Words}"
            SelectedRows="{Binding RawSelectedWords, Mode=TwoWay}"
            AllowResizingColumns="True"
            SelectionMode="Multiple"
            GridLinesVisibility="Both"
            HeaderGridLinesVisibility="Both"
            NavigationMode="Row"
            Margin="10"
            RowHeight="40">
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:DataGridTextColumn MappingName="Id" HeaderText="ID" Width="75" />
                <syncfusion:DataGridTextColumn MappingName="Value" HeaderText="Word" Width="150" />
                <syncfusion:DataGridNumericColumn MappingName="Popularity" HeaderText="Popularity" CellTextAlignment="Start" HeaderTextAlignment="Start" Format="0.##########" Width="125" />
                <syncfusion:DataGridTextColumn MappingName="PartOfSpeech" HeaderText="Type" Width="100" CellTextAlignment="Center" HeaderTextAlignment="Center"/>
                <syncfusion:DataGridTemplateColumn MappingName="ShouldStudy" HeaderText="Should Study" Width="100" CellTextAlignment="Center" HeaderTextAlignment="Center">
                    <syncfusion:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:Word">
                            <CheckBox IsChecked="{Binding ShouldStudy, Mode=OneWay}" IsEnabled="False" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </DataTemplate>
                    </syncfusion:DataGridTemplateColumn.CellTemplate>
                </syncfusion:DataGridTemplateColumn>
                <syncfusion:DataGridTemplateColumn MappingName="Learned" HeaderText="Learned" CellTextAlignment="Center" HeaderTextAlignment="Center">
                    <syncfusion:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:Word">
                            <CheckBox IsChecked="{Binding Learned, Mode=OneWay}" IsEnabled="False" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </DataTemplate>
                    </syncfusion:DataGridTemplateColumn.CellTemplate>
                </syncfusion:DataGridTemplateColumn>
                <syncfusion:DataGridTextColumn MappingName="Comments" HeaderText="Comments" CellTextAlignment="Center" />
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

        <HorizontalStackLayout Grid.Row="2" Spacing="10">
            <Button Text="Parse" Command="{Binding ParseCommand}" />
            <Button Text="Definitions" Command="{Binding DefinitionsCommand}" />
            <Button Text="Mark" Command="{Binding MarkCommand}" />
            <Button Text="Learn" Command="{Binding LearnCommand}" />
            <Button Text="Change" Command="{Binding ChangeCommand}" />
            <Button Text="Add" Command="{Binding AddCommand}" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>