<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
    xmlns:inputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SmartBox.ViewModels"
    x:Class="SmartBox.Views.DictionaryPage">

    <Grid Padding="30,0" RowDefinitions="Auto,*,Auto">

        <HorizontalStackLayout Grid.Row="0" Spacing="10">
            <Entry x:Name="WordEntry" Placeholder="Word" Text="{Binding SearchText, Mode=TwoWay}">
                <Entry.Behaviors>
                    <toolkit:UserStoppedTypingBehavior
                        Command="{Binding SearchCommand}"
                        StoppedTypingTimeThreshold="1000" />
                </Entry.Behaviors>
            </Entry>
            <Entry x:Name="CommentEntry" Placeholder="Comment"/>
            <inputs:SfComboBox 
                x:Name="PartOfSpeechComboBox"
                ItemsSource="{Binding PartOfSpeechOptions}"
                SelectedItem="{Binding SelectedPartOfSpeech, Mode=TwoWay}"
                MinimumWidthRequest="150"
                IsClearButtonVisible="False"
                IsEditable="False"/>
        </HorizontalStackLayout>

        <syncfusion:SfDataGrid
            x:Name="WordTable"
            Grid.Row="1"
            ItemsSource="{Binding Words}"
            SelectedRows="{Binding RawSelectedWords, Mode=TwoWay}"
            AllowResizingColumns="True"
            SelectionMode="Multiple"
            GridLinesVisibility="Both"
            HeaderGridLinesVisibility="Both"
            NavigationMode="Row"
            Margin="10">
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:DataGridTextColumn MappingName="Id" HeaderText="ID" />
                <syncfusion:DataGridTextColumn MappingName="Value" HeaderText="Word" />
                <syncfusion:DataGridNumericColumn MappingName="Popularity" HeaderText="Popularity" Format="0.##########" />
                <syncfusion:DataGridTextColumn MappingName="PartOfSpeech" HeaderText="Type" />
                <syncfusion:DataGridTemplateColumn MappingName="ShouldStudy" HeaderText="Should Study">
                    <syncfusion:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding ShouldStudy, Mode=OneWay}" IsEnabled="False" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </DataTemplate>
                    </syncfusion:DataGridTemplateColumn.CellTemplate>
                </syncfusion:DataGridTemplateColumn>
                <syncfusion:DataGridTemplateColumn MappingName="Learned" HeaderText="Learned">
                    <syncfusion:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Learned, Mode=OneWay}" IsEnabled="False" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </DataTemplate>
                    </syncfusion:DataGridTemplateColumn.CellTemplate>
                </syncfusion:DataGridTemplateColumn>
                <syncfusion:DataGridTextColumn MappingName="Comments" HeaderText="Comments" />
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

        <HorizontalStackLayout Grid.Row="2" Spacing="10">
            <Button Text="Mark" Command="{Binding MarkCommand}" />
            <Button Text="Learn" Command="{Binding LearnCommand}" />
            <Button Text="Add" Command="{Binding AddCommand}" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>