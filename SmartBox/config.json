{
  "OpenAi": {
    "Model": "gpt-5.4",
    "ApiKeyEnvVar": "OPENAI_API_KEY",
    "MaxOutputTokens": 128000
  },
  "Ai": {
    "FillMissingExamplesIfBelow": 3,
    "ExamplesPerMeaningForNewWords": 4,
    "ExamplesPerMeaningForFilling": 3
  },
  "CambridgeDictionary": {
    "TimeoutSeconds": 20
  },
  "Database": {
    "ConnectionStringEnvVar": "ENGLISH_WORDS_STORAGE"
  },
  "Window": {
    "Width": 1150,
    "Height": 700
  },
  "Backup": {
    "IntervalHours": 24,
    "KeepCount": 30
  }
}
